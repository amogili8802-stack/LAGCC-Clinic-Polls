# Database — a Postgres connection string. A free hosted Postgres (Neon,
# Vercel Postgres, or Supabase all work) is the easiest option, and using
# the same one for local dev and production keeps things simple.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Twilio (leave blank in dev — SMS sends will be logged to the console instead)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Default coach account created by `npm run db:seed`
SEED_COACH_EMAIL="headpro@lagcc.example"
SEED_COACH_PASSWORD="change-me-now"
SEED_COACH_NAME="Head Pro"

# Club name shown in headers and text messages
CLUB_NAME="LAGCC"
