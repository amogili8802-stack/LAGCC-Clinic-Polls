generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A recurring weekly clinic slot, e.g. "Super Stars" Tuesdays 3:30-4:30, ages 3-6.
// This is the template used to generate ClinicSession rows week by week.
model ClinicTemplate {
  id          String   @id @default(cuid())
  name        String
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startTime   String // "15:30" 24h local time
  endTime     String // "16:30"
  ageMin      Int
  ageMax      Int
  capacity    Int      @default(8)
  minSignups  Int      @default(4)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  sessions    ClinicSession[]
  recurringSignups RecurringSignup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// status/cancellationReason are plain strings, validated in application code:
//   status:             "SCHEDULED" | "CANCELLED"
//   cancellationReason: "RAIN" | "HEAT" | "LOW_SIGNUPS" | "OTHER"

// One specific occurrence of a ClinicTemplate on a specific date.
// Generated on demand the first time a given week is viewed.
model ClinicSession {
  id                 String         @id @default(cuid())
  templateId         String
  template           ClinicTemplate @relation(fields: [templateId], references: [id])
  date               DateTime // the calendar date of this occurrence (local midnight)
  capacity           Int
  minSignups         Int            @default(4)
  status             String         @default("SCHEDULED")
  cancellationReason String?
  cancellationNote   String?
  cancelledAt        DateTime?
  cancelledBy        String?
  signups            Signup[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([templateId, date])
  @@index([date])
}

model Signup {
  id                String           @id @default(cuid())
  sessionId         String
  session           ClinicSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recurringSignupId String?
  recurringSignup   RecurringSignup? @relation(fields: [recurringSignupId], references: [id])
  parentId          String?
  parent            Parent?          @relation(fields: [parentId], references: [id])
  parentName        String
  parentPhone       String
  parentEmail       String?
  kidName           String
  kidAge            Int
  memberNumber      String?
  waitlisted        Boolean          @default(false)
  addedByCoach      Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now())
  cancelledAt       DateTime?
  lateCancellation  Boolean          @default(false)

  @@index([sessionId])
  @@index([parentPhone])
  @@index([recurringSignupId])
  @@index([parentId])
}

// A standing weekly sign-up: once created, every week's sync (in
// ensureAndGetWeekSessions) auto-enrolls this kid in that week's session
// for the matching ClinicTemplate, without the parent doing anything.
model RecurringSignup {
  id           String         @id @default(cuid())
  templateId   String
  template     ClinicTemplate @relation(fields: [templateId], references: [id])
  parentId     String?
  parent       Parent?        @relation(fields: [parentId], references: [id])
  parentName   String
  parentPhone  String
  parentEmail  String?
  kidName      String
  kidAge       Int
  memberNumber String?
  active       Boolean        @default(true)
  signups      Signup[]
  createdAt    DateTime       @default(now())
  cancelledAt  DateTime?

  @@index([templateId])
  @@index([parentPhone])
  @@index([parentId])
}

// A parent's account — phone + password login, used to sign kids up and
// manage/cancel/view history from a "my account" page instead of the old
// type-your-phone-number self-serve lookup.
model Parent {
  id               String            @id @default(cuid())
  phone            String            @unique // normalized digits-only, see lib/phone.ts
  passwordHash     String
  name             String
  email            String?
  createdAt        DateTime          @default(now())
  signups          Signup[]
  recurringSignups RecurringSignup[]
}

model Coach {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
